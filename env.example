# Copy to .env and adjust as needed.

# Postgres connection used by Drizzle/node-postgres (apps/web, packages/db, packages/domain)
DATABASE_URL="postgresql://kds:kds@localhost:5432/kds"

# Session cookie signing secret (demo only — rotate for any real deployment; min 32 chars)
SESSION_SECRET="dev-only-change-me-dev-only-change-me"

# HMAC secret the demo order adapter uses to sign simulated webhooks
DEMO_ADAPTER_SECRET="dev-only-demo-adapter-secret"

# Web app port
PORT=3000

# Store timezone used for display/scheduling in the single-store demo
STORE_TIMEZONE="America/Chicago"

# Set to 1 when the app runs inside a cross-site iframe (e.g. a hosted preview pane):
# the session cookie becomes SameSite=None; Secure; Partitioned. Needs HTTPS.
# SESSION_COOKIE_EMBEDDED=1
